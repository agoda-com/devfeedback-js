{
  "name": "agoda-devfeedback-common",
  "version": "2.2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devfeedback-shell": "./dist/cli/shell.cjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks/preinstall": "./dist/hooks/preinstall.cjs",
    "./hooks/postinstall": "./dist/hooks/postinstall.cjs",
    "./nx": {
      "types": "./dist/nx.d.ts",
      "import": "./dist/nx.js",
      "require": "./dist/nx.cjs"
    },
    "./pnpmfile": {
      "types": "./dist/pnpmfile.d.ts",
      "import": "./dist/pnpmfile.js",
      "require": "./dist/pnpmfile.cjs"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "postinstall": "node ./dist/hooks/postinstall.cjs --self || exit 0"
  },
  "dependencies": {
    "axios": "1.8.4",
    "tslib": "2.8.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/agoda-com/devfeedback-js"
  }
}
